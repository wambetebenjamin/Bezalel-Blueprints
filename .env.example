# ---------------------------------------------------------------------------
# Bezalel Blueprints environment
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------------------

# WhatsApp. Click to chat number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# Public site URL. Used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=https://bezalel-blueprints.vercel.app

# Locales enabled in the language switcher. Comma separated, first is default.
NEXT_PUBLIC_LOCALES=en,sw,fr
NEXT_PUBLIC_DEFAULT_LOCALE=en

# reCAPTCHA v3. Server side verification of forms.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# reCAPTCHA v2 checkbox, shown as a fallback when the v3 score is below the threshold.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
# Scores below this value fall back to the v2 checkbox challenge.
RECAPTCHA_MIN_SCORE=0.5

# NextAuth v5.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Optional credentials provider for the light sign in used to save blueprints.
# When these are empty, sign in is disabled and saving stays local to the browser.
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=
